# Claude writes and verifies the storyboard. Without it the app uses examples/ecuacion-lineal.v2.json.
ANTHROPIC_API_KEY=

# Voice: estimate (silent, default) | kokoro (free, local, dev) | elevenlabs (production) | voicestudio (local, non-commercial)
VOICE_PROVIDER=kokoro
KOKORO_VOICE=ef_dora
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICESTUDIO_URL=http://127.0.0.1:8000

# Render worker (Supabase queue). Not needed for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chromium for HyperFrames when it is not auto-detected.
HYPERFRAMES_BROWSER_PATH=
